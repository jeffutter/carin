{
  "openapi": "3.1.0",
  "info": {
    "title": "Cairn API",
    "description": "Read routes of the Cairn JSON API. Loopback only, no auth, no CORS.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/artifacts": {
      "get": {
        "tags": [],
        "summary": "List Artifacts, newest activity first.",
        "operationId": "list_artifacts",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "description": "`markdown`, `html`, `image` or `diagram`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session",
            "in": "query",
            "description": "Latest Revision made in this Session.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "description": "Latest Revision made by this author.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "open",
            "in": "query",
            "description": "Only Artifacts with at least one open Thread.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "older_than",
            "in": "query",
            "description": "Only Artifacts last updated longer ago than this: `30d`, `12h`, `90m`, `45s` or `2w`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1 to 200; default 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "project",
            "in": "query",
            "description": "Project name.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project_root",
            "in": "query",
            "description": "Absolute path of the Project's main checkout.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "worktree",
            "in": "query",
            "description": "Absolute path of a linked Worktree: shows the Project root's Artifacts\nplus that Worktree's, as the CLI does from inside one.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artifacts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactList"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query string, path segment or id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such Artifact, Revision or file.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Reserved for writes (`edit` against a stale Revision); no read returns it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Well-formed but refused: a limit out of range, an ambiguous or missing\nSection, a Kind without Sections.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Anything else, including a database busy past its timeout.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{id}": {
      "get": {
        "tags": [],
        "summary": "One Artifact.",
        "operationId": "get_artifact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Bare Artifact id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The Artifact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactDetail"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query string, path segment or id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such Artifact, Revision or file.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Reserved for writes (`edit` against a stale Revision); no read returns it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Well-formed but refused: a limit out of range, an ambiguous or missing\nSection, a Kind without Sections.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Anything else, including a database busy past its timeout.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{id}/comments": {
      "get": {
        "tags": [],
        "summary": "Threads of an Artifact, with their replies.",
        "operationId": "list_comments",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Bare Artifact id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all",
            "in": "query",
            "description": "Include resolved Threads.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Only Threads holding a Comment with a larger id.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Threads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentList"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query string, path segment or id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such Artifact, Revision or file.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Reserved for writes (`edit` against a stale Revision); no read returns it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Well-formed but refused: a limit out of range, an ambiguous or missing\nSection, a Kind without Sections.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Anything else, including a database busy past its timeout.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{id}/outline": {
      "get": {
        "tags": [],
        "summary": "The headings of a markdown Artifact.",
        "operationId": "get_outline",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Bare Artifact id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "description": "Revision number; latest by default.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Outline",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Outline"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query string, path segment or id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such Artifact, Revision or file.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Reserved for writes (`edit` against a stale Revision); no read returns it.",
            "content": {
