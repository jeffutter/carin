                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{id}/revisions": {
      "get": {
        "tags": [],
        "summary": "Every Revision of an Artifact, oldest first.",
        "operationId": "list_revisions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Bare Artifact id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revisions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevisionList"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query string, path segment or id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such Artifact, Revision or file.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Reserved for writes (`edit` against a stale Revision); no read returns it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Well-formed but refused: a limit out of range, an ambiguous or missing\nSection, a Kind without Sections.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Anything else, including a database busy past its timeout.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{id}/revisions/{n}": {
      "get": {
        "tags": [],
        "summary": "One Revision as a file manifest.",
        "operationId": "get_revision",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Bare Artifact id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "n",
            "in": "path",
            "description": "Revision number, 1-based",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevisionManifest"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query string, path segment or id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such Artifact, Revision or file.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Reserved for writes (`edit` against a stale Revision); no read returns it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Well-formed but refused: a limit out of range, an ambiguous or missing\nSection, a Kind without Sections.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Anything else, including a database busy past its timeout.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{id}/revisions/{n}/files/{path}": {
      "get": {
        "tags": [],
        "summary": "Raw bytes of one stored file, with its stored media type. Always an\nattachment with `nosniff`: rendering untrusted bytes is the content\norigin's job, never this route's.",
        "operationId": "get_file",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Bare Artifact id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "n",
            "in": "path",
            "description": "Revision number, 1-based",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "path",
            "in": "path",
            "description": "Stored file path; may contain slashes",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "section",
            "in": "query",
            "description": "Markdown only: return just this Section, as the CLI's `get --section`\nresolves it (`A > B`, optional `#n`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file's bytes. `Content-Type` is the stored media type (`text/markdown` for a Section); `Content-Disposition: attachment` and `X-Content-Type-Options: nosniff` are always set.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/RawBytes"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query string, path segment or id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such Artifact, Revision or file.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Reserved for writes (`edit` against a stale Revision); no read returns it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Well-formed but refused: a limit out of range, an ambiguous or missing\nSection, a Kind without Sections.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Anything else, including a database busy past its timeout.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListRow"
          },
          {
            "type": "object",
            "required": [
              "created_at"
            ],
            "properties": {
              "created_at": {
                "type": "string"
              },
              "format": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Diagram format (`mermaid` or `svg`); null for other Kinds."
              }
            }
          }
        ],
        "description": "One Artifact: its list row plus what a list leaves out."
      },
      "ArtifactList": {
        "type": "object",
        "description": "What `list` prints on the CLI and `GET /api/v1/artifacts` returns.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListRow"
            }
          }
        }
      },
      "CommentList": {
        "type": "object",
        "required": [
          "threads",
          "highest_comment_id"
        ],
        "properties": {
          "highest_comment_id": {
            "type": "integer",
            "format": "int64"
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Thread"
            }
          }
        }
      },
      "FileEntry": {
        "type": "object",
        "description": "One stored file of a Revision, without its bytes.",
        "required": [
          "path",
          "media_type",
          "size",
          "sha256"
        ],
        "properties": {
          "media_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "description": "Lowercase hex SHA-256 of the file's bytes."
          },
          "size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ListRow": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "latest_revision",
          "open_threads",
          "author",
          "bytes",
          "updated_at"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Sum of the sizes of the distinct blobs any Revision of the Artifact\nreferences: what the Artifact costs in the database file."
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "latest_revision": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "open_threads": {
            "type": "integer",
            "format": "int64"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_root": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string"
          },
          "worktree": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Outline": {
        "type": "object",
        "description": "What `outline` prints on the CLI and `GET /api/v1/artifacts/{id}/outline` returns.",
        "required": [
          "sections"
        ],
        "properties": {
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutlineEntry"
            }
          }
        }
      },
      "OutlineEntry": {
        "type": "object",
        "required": [
          "path",
          "level",
          "bytes"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "description": "Byte length of the Section, children included.",
            "minimum": 0
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "path": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable identifier shared with the CLI: `usage`, `not_found`,\n`rejected_input`, `conflict` or `unexpected`."
          },
          "detail": {
            "type": "string",
            "description": "The message the CLI prints for the same failure."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "The HTTP status phrase."
          },
          "type": {
            "type": "string",
            "description": "Always `about:blank`: the status and `code` carry the meaning."
          }
        }
      },
      "RawBytes": {
        "type": "string",
        "format": "binary",
        "description": "Schema stand-in for a raw file body."
      },
      "Reply": {
        "type": "object",
        "required": [
          "id",
          "author",
          "role",
          "body",
          "created_at"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "role": {
            "type": "string"
          },
          "session": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RevisionList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RevisionSummary"
            }
          }
        }
      },
      "RevisionManifest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RevisionSummary"
          },
          {
            "type": "object",
            "required": [
              "artifact",
              "files"
            ],
            "properties": {
              "artifact": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FileEntry"
                }
              }
            }
          }
        ],
        "description": "A Revision as a file manifest."
      },
